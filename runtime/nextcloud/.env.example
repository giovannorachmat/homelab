# SQLite auto-config: no DB env vars set = SQLite default.
# Change these before first run, then start with:
#   docker compose -f services/nextcloud/docker-compose.yml up -d
SQLITE_DATABASE=your-sqlite-database-here
NEXTCLOUD_ADMIN_USER=your-nextcloud-admin-user-here
NEXTCLOUD_ADMIN_PASSWORD=your-nextcloud-admin-password-here
NEXTCLOUD_DATA_DIR=your-nextcloud-data-dir-here
NEXTCLOUD_TRUSTED_DOMAINS=your-nextcloud-trusted-domains-here
