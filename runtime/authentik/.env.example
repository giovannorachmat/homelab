# Do NOT commit real secrets. This file is gitignored by repo policy.
# Minimal bootstrap env for authentik stack

AUTHENTIK_SECRET_KEY=your-authentik-secret-key-here

AUTHENTIK_POSTGRESQL__USER=your-authentik-postgresql--user-here
AUTHENTIK_POSTGRESQL__PASSWORD=your-authentik-postgresql--password-here
AUTHENTIK_POSTGRESQL__NAME=your-authentik-postgresql--name-here

# Postgres container expects these variable names
POSTGRES_DB=your-postgres-db-here
POSTGRES_USER=your-postgres-user-here
POSTGRES_PASSWORD=your-postgres-password-here
